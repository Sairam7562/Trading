// This Pine Script™ is subject to the terms of the Mozilla Public License 2.0
// © EMA9/20 + SuperTrend Classic Strategy

//@version=5
strategy("V1: EMA 9/20 Cross + SuperTrend Classic", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=1, initial_capital=100000, currency=currency.INR)

// ─── Inputs ──────────────────────────────────────────
emaFast      = input.int(9, "EMA Fast Period", minval=1)
emaSlow      = input.int(20, "EMA Slow Period", minval=1)
stPeriod     = input.int(10, "SuperTrend ATR Period", minval=1)
stMultiplier = input.float(3.0, "SuperTrend Multiplier", step=0.1)
slAtrMult    = input.float(1.5, "SL ATR Multiplier", step=0.1)
tgtAtrMult   = input.float(2.0, "Target ATR Multiplier", step=0.1)
minRR        = input.float(1.5, "Minimum Reward:Risk Ratio", step=0.1)
noTradeHour  = input.int(14, "No New Trade After Hour")
noTradeMin   = input.int(45, "No New Trade After Minute")
exitHour     = input.int(15, "Force Exit Hour")
exitMin      = input.int(15, "Force Exit Minute")

// ─── Indicators ──────────────────────────────────────
ema9  = ta.ema(close, emaFast)
ema20 = ta.ema(close, emaSlow)
atr14 = ta.atr(14)

// SuperTrend
[stLine, stDir] = ta.supertrend(stMultiplier, stPeriod)

// ─── EMA Crossover Detection ────────────────────────
emaCrossUp   = ta.crossover(ema9, ema20)
emaCrossDown = ta.crossunder(ema9, ema20)

// ─── Time Filter ─────────────────────────────────────
currentTime    = hour * 100 + minute
noTradeTime    = noTradeHour * 100 + noTradeMin
exitTime       = exitHour * 100 + exitMin
inTradeWindow  = currentTime >= 920 and currentTime <= noTradeTime
isExitTime     = currentTime >= exitTime

// ─── Signal Conditions ──────────────────────────────
// V1 CLASSIC: Both EMA crossover AND SuperTrend must agree

// BUY: EMA9 crosses above EMA20 + ST bullish + Close > EMA20 + Close > ST
buySignal = emaCrossUp and stDir < 0 and close > ema20 and close > stLine and inTradeWindow
// Note: ta.supertrend returns direction < 0 for bullish (uptrend)

// SELL: EMA9 crosses below EMA20 + ST bearish + Close < EMA20 + Close < ST
sellSignal = emaCrossDown and stDir > 0 and close < ema20 and close < stLine and inTradeWindow

// ─── Entry Logic ─────────────────────────────────────
if buySignal
    sl = math.max(stLine, close - slAtrMult * atr14)
    risk = close - sl
    target = close + tgtAtrMult * atr14
    if risk > 0 and target < close + minRR * risk
        target := close + minRR * risk
    strategy.entry("BUY", strategy.long)
    strategy.exit("BUY_EXIT", "BUY", stop=sl, limit=target)

if sellSignal
    sl = math.min(stLine, close + slAtrMult * atr14)
    risk = sl - close
    target = close - tgtAtrMult * atr14
    if risk > 0 and target > close - minRR * risk
        target := close - minRR * risk
    strategy.entry("SELL", strategy.short)
    strategy.exit("SELL_EXIT", "SELL", stop=sl, limit=target)

// ─── Force Exit at Session End ───────────────────────
if isExitTime
    strategy.close_all("Session End")

// ─── Plots ───────────────────────────────────────────
plot(ema9, "EMA 9", color=color.new(color.blue, 0), linewidth=2)
plot(ema20, "EMA 20", color=color.new(color.orange, 0), linewidth=2)
plot(stLine, "SuperTrend", color=stDir < 0 ? color.green : color.red, linewidth=2, style=plot.style_linebr)

// Signal markers
plotshape(buySignal, "BUY", shape.triangleup, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(sellSignal, "SELL", shape.triangledown, location.abovebar, color.new(color.red, 0), size=size.small)

// Background coloring for trend
bgcolor(ema9 > ema20 and stDir < 0 ? color.new(color.green, 93) : ema9 < ema20 and stDir > 0 ? color.new(color.red, 93) : na)

// ─── Alert Conditions ────────────────────────────────
alertcondition(buySignal, title="V1 BUY Signal", message="V1 CLASSIC: BUY — EMA9 crossed above EMA20, SuperTrend bullish")
alertcondition(sellSignal, title="V1 SELL Signal", message="V1 CLASSIC: SELL — EMA9 crossed below EMA20, SuperTrend bearish")
